<Window x:Class="PowerSupplyDebugger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:PowerSupplyDebugger.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GW Instek PSW 四机调试工具"
        Width="1480" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="SmallCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="178"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GW Instek PSW 四机调试工具" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding GlobalStatus}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="连接四机（只读）" Command="{Binding ConnectAllCommand}" Margin="0,0,8,0"/>
                <Button Content="刷新在线设备" Command="{Binding RefreshAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                <Button Content="保存设备配置" Command="{Binding SaveConfigurationCommand}" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,10,0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold"/>
                                <Border Grid.Column="1" x:Name="ConnectionBadge" CornerRadius="10" Padding="8,3"
                                        Background="{StaticResource DisabledSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="ConnectionText" Text="离线" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1" Margin="0,6,0,10" Foreground="{StaticResource MutedTextBrush}">
                                <Run Text="{Binding Host, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding PortText, Mode=OneWay}"/>
                            </TextBlock>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="实测电压" Style="{StaticResource SmallCaption}"/>
                                    <TextBlock Style="{StaticResource MetricValue}" FontSize="20">
                                        <Run Text="{Binding MeasuredVoltage, Mode=OneWay, StringFormat={}{0:0.000}}"/><Run Text=" V" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="实测电流" Style="{StaticResource SmallCaption}"/>
                                    <TextBlock Style="{StaticResource MetricValue}" FontSize="20">
                                        <Run Text="{Binding MeasuredCurrent, Mode=OneWay, StringFormat={}{0:0.000}}"/><Run Text=" A" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="3" x:Name="OutputBadge" CornerRadius="4" Padding="8,5" Margin="0,9,0,0"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock x:Name="OutputText" Text="{Binding OutputStatusText}" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                            <Setter TargetName="ConnectionBadge" Property="Background" Value="{StaticResource SuccessSurfaceBrush}"/>
                            <Setter TargetName="ConnectionBadge" Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}"/>
                            <Setter TargetName="ConnectionText" Property="Text" Value="在线"/>
                            <Setter TargetName="ConnectionText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding OutputEnabled}" Value="True">
                            <Setter TargetName="OutputBadge" Property="Background" Value="{StaticResource DangerSurfaceBrush}"/>
                            <Setter TargetName="OutputBadge" Property="BorderBrush" Value="{StaticResource DangerBorderBrush}"/>
                            <Setter TargetName="OutputText" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,14,0,12" DataContext="{Binding SelectedDevice}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource DangerSurfaceBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="12" Margin="0,0,0,10"
                            Visibility="{Binding OutputEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="危险：当前设备输出为 ON。修改设定值会立即影响负载。"
                                   Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                    <GroupBox Header="连接与设备配置">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"
                                     IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Terminator, UpdateSourceTrigger=PropertyChanged}" ToolTip="SCPI 终止符，默认 \r\n"
                                     IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"/>
                            <TextBox Grid.Row="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"
                                     IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                     IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBooleanConverter}}"/>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                <Button Content="连接（只读）" Command="{Binding ConnectCommand}" Margin="0,0,8,8"/>
                                <Button Content="断开" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                <Button Content="立即刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/>
                            </StackPanel>
                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding ConnectionMessage}"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="设定与保护">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="82"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="VSET (V)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding VoltageInput, UpdateSourceTrigger=PropertyChanged}" Margin="6,4"/>
                            <Button Grid.Column="2" Content="写入" Command="{Binding ApplyVoltageCommand}" Margin="4"/>
                            <TextBlock Grid.Row="1" Text="ISET (A)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentInput, UpdateSourceTrigger=PropertyChanged}" Margin="6,4"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="写入" Command="{Binding ApplyCurrentCommand}" Margin="4"/>
                            <TextBlock Grid.Row="2" Text="OVP (V)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OvpInput, UpdateSourceTrigger=PropertyChanged}" Margin="6,4"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="写入" Command="{Binding ApplyOvpCommand}" Margin="4"/>
                            <TextBlock Grid.Row="3" Text="OCP (A)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OcpInput, UpdateSourceTrigger=PropertyChanged}" Margin="6,4"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="写入" Command="{Binding ApplyOcpCommand}" Margin="4"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="输出控制">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputStatusText}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="OUTP ON（需确认）" Command="{Binding OutputOnCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                                <Button Content="OUTP OFF" Command="{Binding OutputOffCommand}" Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                            <TextBlock Text="写入仅对选中设备生效；程序不提供批量设定或批量输出。"
                                       Style="{StaticResource SmallCaption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2">
                <TabItem Header="状态总览">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14">
                            <UniformGrid Columns="3" Margin="0,0,0,12">
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="实测电压" Style="{StaticResource SmallCaption}"/>
                                        <TextBlock Style="{StaticResource MetricValue}">
                                            <Run Text="{Binding MeasuredVoltage, Mode=OneWay, StringFormat={}{0:0.000}}"/><Run Text=" V" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="实测电流" Style="{StaticResource SmallCaption}"/>
                                        <TextBlock Style="{StaticResource MetricValue}">
                                            <Run Text="{Binding MeasuredCurrent, Mode=OneWay, StringFormat={}{0:0.000}}"/><Run Text=" A" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="实测功率" Style="{StaticResource SmallCaption}"/>
                                        <TextBlock Style="{StaticResource MetricValue}">
                                            <Run Text="{Binding MeasuredPower, Mode=OneWay, StringFormat={}{0:0.000}}"/><Run Text=" W" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <GroupBox Header="身份与额定能力">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Text="*IDN? 原始响应" Style="{StaticResource SmallCaption}" Margin="0,4"/>
                                    <TextBox Grid.Column="1" Text="{Binding Identity, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="1" Text="识别型号" Style="{StaticResource SmallCaption}" Margin="0,8,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Model}" Margin="6,8,0,4"/>
                                    <TextBlock Grid.Row="2" Text="额定上限" Style="{StaticResource SmallCaption}" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="6,4">
                                        <Run Text="{Binding MaxVoltage, Mode=OneWay, StringFormat={}{0:0.###}}"/><Run Text=" V / "/>
                                        <Run Text="{Binding MaxCurrent, Mode=OneWay, StringFormat={}{0:0.###}}"/><Run Text=" A"/>
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Text="控制来源" Style="{StaticResource SmallCaption}" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ControlState}" Margin="6,4"/>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="运行与状态位">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="稳压 / 恒流" Style="{StaticResource SmallCaption}"/>
                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="CV="/><Run Text="{Binding IsConstantVoltage, Mode=OneWay}"/>
                                            <Run Text="  CC="/><Run Text="{Binding IsConstantCurrent, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="限制 / 保护" Style="{StaticResource SmallCaption}"/>
                                        <TextBlock Margin="0,5,0,0">
                                            <Run Text="V="/><Run Text="{Binding IsVoltageLimited, Mode=OneWay}"/>
                                            <Run Text="  I="/><Run Text="{Binding IsCurrentLimited, Mode=OneWay}"/>
                                            <Run Text="  P="/><Run Text="{Binding IsPowerLimited, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock><Run Text="跳闸="/><Run Text="{Binding ProtectionTripped, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="状态寄存器（十进制）" Style="{StaticResource SmallCaption}"/>
                                        <TextBlock Margin="0,5,0,0"><Run Text="OPER: "/><Run Text="{Binding OperationStatus, Mode=OneWay}"/></TextBlock>
                                        <TextBlock><Run Text="QUES: "/><Run Text="{Binding QuestionableStatus, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <TextBlock Text="{Binding LastError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="4,4,4,0"/>
                            <TextBlock Text="{Binding LastUpdate, StringFormat=最近刷新：{0}}" Style="{StaticResource SmallCaption}" Margin="4,5,4,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="错误队列">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="人工读取错误队列" Command="{Binding ReadErrorsCommand}"/>
                            <TextBlock Text="自动轮询不会读取 SYST:ERR?，避免消耗队列。" Style="{StaticResource SmallCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Text="{Binding ErrorQueueText, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                    </Grid>
                </TabItem>

                <TabItem Header="原始 SCPI">
                    <Grid Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="高级功能：查询命令可直接发送；写命令必须取消“等待响应”，并进行危险操作确认。"
                                   Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding RawCommand, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,10,10"/>
                            <CheckBox Grid.Column="1" Content="等待响应" IsChecked="{Binding RawExpectResponse}" VerticalAlignment="Center" Margin="0,0,10,10"/>
                            <Button Grid.Column="2" Content="发送一次" Command="{Binding SendRawCommand}" Margin="0,0,0,10"/>
                        </Grid>
                        <TextBox Grid.Row="2" Text="{Binding RawResponse, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </TabItem>

                <TabItem Header="完整通信日志">
                    <Grid Margin="14" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="清空界面日志" Command="{Binding ClearLogCommand}" Style="{StaticResource SecondaryButton}"/>
                            <TextBlock Text="磁盘日志按日期保存在 LocalAppData，清空界面不会删除文件。" Style="{StaticResource SmallCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding LogEntries}" FontFamily="Consolas"
                                 Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,9,0,0">
            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                       Text="安全策略：连接只读；写入前验证 GW Instek PSW 身份；命令不自动重试；写入与 OUTP 操作均立即回读。"/>
        </Border>
    </Grid>

</Window>
