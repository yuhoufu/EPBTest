<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UnattendedProductVersion>2.17.2.0</UnattendedProductVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">$(UnattendedProductVersion)</ApplicationVersion>
    <_UnattendedVersionAssemblyInfo>$(MSBuildProjectDirectory)\obj\$(Configuration)\UnattendedVersion.g.cs</_UnattendedVersionAssemblyInfo>
  </PropertyGroup>

  <Target Name="GenerateUnattendedVersionAssemblyInfo" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_UnattendedAssemblyAttribute Include="System.Reflection.AssemblyVersionAttribute">
        <_Parameter1>$(UnattendedProductVersion)</_Parameter1>
      </_UnattendedAssemblyAttribute>
      <_UnattendedAssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
        <_Parameter1>$(UnattendedProductVersion)</_Parameter1>
      </_UnattendedAssemblyAttribute>
      <_UnattendedAssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
        <_Parameter1>$(UnattendedProductVersion)</_Parameter1>
      </_UnattendedAssemblyAttribute>
    </ItemGroup>
    <WriteCodeFragment
      AssemblyAttributes="@(_UnattendedAssemblyAttribute)"
      Language="C#"
      OutputFile="$(_UnattendedVersionAssemblyInfo)">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>
</Project>
