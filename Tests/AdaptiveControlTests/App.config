<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 测试宿主无现场配置文件；与 MTTfTest\App.config 的 DAQ 会话参数保持一致，
         供 DaqRuntimeSettings.Load 与 FrmEpbMainMonitor 无参构造在测试进程内读取。 -->
    <add key="DaqFrequency" value="2000" />
    <add key="SamplesPerChannel" value="20" />
  </appSettings>
</configuration>
