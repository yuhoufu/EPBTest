  <Target Name="CopyWatchdogSidecarForTests" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)..\..\MTTFTest.Watchdog\bin\$(Configuration)\MTTFTest.Watchdog.exe"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <!--
    MTTfTest is a production WinForms host and brings a larger runtime
    dependency closure than the test compiler sees through its project
    reference (notably the DevExpress Office/RichEdit/Grid/Layout modules).
    Copy the complete production output tree after the referenced project has
    built so a fresh test output is self-contained.  This is deliberately an
    MSBuild project-to-project copy, not a machine-local/manual setup step.
  -->
  <Target Name="CopyMttfTestRuntimeClosure" AfterTargets="Build">
    <ItemGroup>
      <MttfTestRuntimeFiles Include="$(ProjectDir)..\..\MTTfTest\bin\$(Configuration)\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(MttfTestRuntimeFiles)"
      DestinationFiles="@(MttfTestRuntimeFiles-&gt;'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
