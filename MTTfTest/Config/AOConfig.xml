<?xml version="1.0" encoding="utf-8"?>
<AOConfig>
	<!-- 全局电压与压力边界，可按需要调整 -->
	<MinVoltage>0</MinVoltage>
	<MaxVoltage>10</MaxVoltage>
	<MinPressure>0</MinPressure>
	<MaxPressure>200</MaxPressure>

	<Devices>
		<Device>
			<Name>Cylinder1</Name>
			<PhysicalChannel>Dev1/ao0</PhysicalChannel>
			<!-- 可选：校准与偏置（电压 = 线性映射 * ScaleK + Offset） -->
			<ScaleK>39.101</ScaleK>
			<Offset>-7.886</Offset>
			<!-- 新增：可选校准表，用于“电压→压力(Bar)”估算（若 DAQ 有闭环则可不配）-->
			<VoltageToPressureTable>
				<Point>
					<Voltage>0</Voltage>
					<Pressure>0.0</Pressure>
				</Point>
				<Point>
					<Voltage>100</Voltage>
					<Pressure>6</Pressure>
				</Point>
			</VoltageToPressureTable>
		</Device>
		<Device>
			<Name>Cylinder2</Name>
			<PhysicalChannel>Dev2/ao0</PhysicalChannel>
			<ScaleK>38.292</ScaleK>
			<Offset>-10.817</Offset>
			<!-- 新增：可选校准表，用于“电压→压力(Bar)”估算（若 DAQ 有闭环则可不配）-->
			<VoltageToPressureTable>
				<Point>
					<Voltage>0</Voltage>
					<Pressure>0.0</Pressure>
				</Point>
				<Point>
					<Voltage>100</Voltage>
					<Pressure>6</Pressure>
				</Point>
			</VoltageToPressureTable>
		</Device>
	</Devices>
</AOConfig>